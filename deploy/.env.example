# Copiar a .env en este mismo directorio del servidor (NUNCA commitear el
# real). Solo lo usa el servicio crm-api vía env_file — crm-web no necesita
# secrets en runtime (su único dato sensible, NEXT_PUBLIC_API_URL, se
# inyecta en build-time como build arg en docker-compose.yml).

DATABASE_URL=
BETTER_AUTH_SECRET=

ANTHROPIC_API_KEY=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=UYU
MERCADOPAGO_USD_TO_UYU_RATE=40

NOWPAYMENTS_API_KEY=
NOWPAYMENTS_PUBLIC_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
