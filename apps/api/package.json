    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@crm/shared": "workspace:*",
    "@hono/node-server": "latest",
    "better-auth": "^1.2.0",
    "bullmq": "latest",
    "drizzle-orm": "^0.45.2",
    "hono": "latest",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "latest",
    "typescript": "^5.5.0"
  }
}
