DATABASE_URL=postgresql://user:password@host:5432/crm_dev
# Rol de runtime sin BYPASSRLS para requests con tenant resuelto — ver
# apps/api/src/middleware/tenant.ts y la migración 0007_enable_rls_tenant_isolation.
DATABASE_URL_APP=postgresql://app_role:password@host:5432/crm_dev
# Conexiones máximas del pool de DATABASE_URL_APP (default 20). Cada request
# con tenant retiene una mientras dura, no solo mientras consulta.
DATABASE_POOL_MAX=20
PORT=3001

# En prod: WEB_URL=https://app.plata.studio, API_PUBLIC_URL=https://api.plata.studio
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
BETTER_AUTH_SECRET=
ANTHROPIC_API_KEY=
REDIS_URL=redis://localhost:6379

# MercadoPago (suscripciones — API de Preapproval)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CURRENCY=UYU
MERCADOPAGO_USD_TO_UYU_RATE=40

# NOWPayments (suscripciones en cripto)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_PUBLIC_KEY=
NOWPAYMENTS_IPN_SECRET=

# Emails con acceso a /admin (separados por coma). Sin esto, /api/admin
# devuelve 403 para todos.
SUPERADMIN_EMAILS=
